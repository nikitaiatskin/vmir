{
  "name": "hanger",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.1.0",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-dev-client": "~58.0.22",
    "expo-file-system": "~58.0.15",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3",
    "eslint-config-expo": "~58.0.4",
    "jest-expo": "~58.0.16"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/modules/.*/ios/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|react-native-svg)"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^hanger-vision$": "<rootDir>/modules/hanger-vision"
    }
  }
}
